{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "manual"
      }
    ]
  ],
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    }
  },
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "external_directory": {
      "~/code/**": "allow",
      "/opt/homebrew/Cellar/hunk/**": "allow"
    },
    "read": {
      "/opt/homebrew/Cellar/hunk/*/libexec/skills/**": "allow"
    },
    "edit": {
      "*": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "external_directory": {
          "~/code/**": "allow",
          "/opt/homebrew/Cellar/hunk/**": "allow"
        },
        "read": {
          "/opt/homebrew/Cellar/hunk/*/libexec/skills/**": "allow"
        },
        "bash": {
          "git commit*": "deny",
          "git add*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git clean*": "deny"
        }
      }
    }
  }
}
