{
  "$schema": "https://opencode.ai/config.json",
	"plugin": ["@plannotator/opencode@latest"],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "yaak": {
      "type": "remote",
      "url": "http://127.0.0.1:64343/mcp",
      "enabled": false
    }
  },
	"experimental": {
		"disable_paste_summary": true
	},
  "permission": {
    "external_directory": {
      "~/code/**": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "git commit*": "deny",
          "git add*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git rebase*": "deny",
          "git merge*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git clean*": "deny"
        }
      }
    }
  }
}
